# Dependencies
node_modules/
package-lock.json

# Build output. The core is consumed as source (npm) or built by the consumer
# (the CDN repo). Publishing a bundle from here would mean two artefacts with
# one version number, which is how they drift.
dist/

# Editor / OS noise
.DS_Store
*.log

# Test scaffolding written and removed by test.mjs during a run. Listed as a
# pattern rather than by name, because a run that fails part way through leaves
# these behind and they are easy to sweep up with a broad git add.
_*.html
